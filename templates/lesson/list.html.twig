{% extends 'base.html.twig' %}

{% block title %}Leçons — {{ course.title }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📚 {{ course.title }}</h2>
        <a href="{{ path('app_course_list') }}" class="btn btn-outline-secondary">
            ← Retour aux cours
        </a>
    </div>

    {% if lessons is empty %}
        <div class="alert alert-info">
            Aucune leçon disponible pour ce cours pour le moment.
        </div>
    {% else %}
        <div class="row g-4">
            {% for lesson in lessons %}
                <div class="col-md-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-primary me-2">Leçon {{ lesson.position }}</span>
                                <strong>{{ lesson.title }}</strong>
                                <span class="text-muted ms-3">⏱ {{ lesson.duration }} min</span>
                            </div>
                            <a href="{{ path('app_lesson_show', {id: lesson.id}) }}" class="btn btn-primary btn-sm">
                                ▶ Voir la leçon
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}